{
  "experiment": {
    "seed": 27,
    "device": null,
    "output_dir": "experiments/results/backdoor_cont_25K_N16_soft",
    "models_dir": "experiments/models/backdoor_cont_25K_N16_soft"
  },
  "dataset": {
    "data_dir": "data",
    "dataset": "backdoor_cont_Z1_25K",
    "train_size": 0.9
  },
  "model": {
    "n_confounders": 1,
    "num_nodes": 16,
    "md_sets": "XZ",
    "fairness_temperature": 3.0,
    "leaf": {
      "Y": {
        "distribution": "gaussian"
      },
      "default": {
        "distribution": "log_linear_spline"
      }
    }
  },
  "training": {
    "batch_size": 8192,
    "total_iters": 300,
    "step_size": 0.1,
    "decay_rate": 0.98,
    "decay_every": 5,
    "log_interval": 20,
    "leaf_lr": null,
    "softening": {
      "noise_std_scale": 0.1
    }
  },
  "checkpointing": {
    "checkpoint_every_epochs": 50,
    "save_initial": true,
    "save_final": true
  },
  "evaluation": {
    "grid_x_points": 100,
    "grid_y_points": 200,
    "grid_x_quantile_range": [
      0.005,
      0.995
    ],
    "slice_contexts": 16
  }
}
